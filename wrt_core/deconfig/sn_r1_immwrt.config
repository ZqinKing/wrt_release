# TARGET config
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_HAS_SUBTARGETS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_sn_r1=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_sn_r1=""

CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
# CONFIG_GDB is not set
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-tun=y

CONFIG_PACKAGE_kmod-warp=y
CONFIG_WARP_VERSION=2
CONFIG_WARP_CHIPSET="mt7981"

CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-emmc-health=y
CONFIG_PACKAGE_luci-app-netcontrol=y
CONFIG_PACKAGE_luci-i18n-netcontrol-zh-cn=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y