@@ -1068,9 +1068,26 @@
 	#echolog "清除定时执行命令。"
 }
 
+smartdns_service_ready() {
+	local smartdns_enabled
+	smartdns_enabled=$(uci -q get smartdns.@smartdns[0].enabled 2>/dev/null)
+	[ -x /etc/init.d/smartdns ] && [ "$smartdns_enabled" = "1" ] && [ -d /etc/smartdns ]
+}
+
 restart_smartdns() {
+	if ! smartdns_service_ready; then
+		echolog "  * 主 SmartDNS 未安装、未启用或配置目录不存在，PassWall 启动中止！"
+		return 1
+	fi
 	rm -rf /tmp/smartdns.cache
-	[ -x /etc/init.d/smartdns ] && /etc/init.d/smartdns reload >/dev/null 2>&1
+	if ! /etc/init.d/smartdns reload >/dev/null 2>&1; then
+		echolog "  * 主 SmartDNS reload 失败，PassWall 启动中止！"
+		return 1
+	fi
+	if ! busybox pidof smartdns >/dev/null 2>&1; then
+		echolog "  * 主 SmartDNS 进程未运行，PassWall 启动中止！"
+		return 1
+	fi
 }
 
 del_smartdns_conf() {
@@ -1081,7 +1098,9 @@
 		sed -i "\|^conf-file ${smartdns_conf}$|d" "$custom_conf"
 	fi
 	rm -rf /tmp/smartdns.cache
-	[ -x /etc/init.d/smartdns ] && /etc/init.d/smartdns reload >/dev/null 2>&1
+	if smartdns_service_ready; then
+		/etc/init.d/smartdns reload >/dev/null 2>&1 || echolog "  * 主 SmartDNS reload 失败，已完成 PassWall 配置清理。"
+	fi
 }
 
