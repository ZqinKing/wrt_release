+smartdns_is_loopback_endpoint() {
+	local endpoint="${1%%,*}"
+	local port="$2"
+	case "$endpoint" in
+		*://*) endpoint="${endpoint#*://}" ;;
+	esac
+	case "$endpoint" in
+		127.0.0.1|localhost|::1|\[::1\]) [ "$port" = "53" ] && return 0 ;;
+		127.0.0.1#"$port"|127.0.0.1:"$port"|localhost#"$port"|localhost:"$port"|::1#"$port"|::1:"$port"|\[::1\]#"$port"|\[::1\]:"$port") return 0 ;;
+	esac
+	return 1
+}
+
 del_smartdns_conf() {
 	local smartdns_conf="/tmp/etc/smartdns/passwall.conf"
 	local custom_conf="/etc/smartdns/custom.conf"
