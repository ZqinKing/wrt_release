+static int ubus_handle_dns_capabilities(struct ubus_context *ctx,
+		struct ubus_object *obj, struct ubus_request_data *req,
+		const char *method, struct blob_attr *msg)
+{
+	int result;
+
+	(void)obj;
+	(void)method;
+	(void)msg;
+	if (blob_buf_init(&b, 0) != 0 ||
+		blobmsg_add_u32(&b, "version", 1U) != 0 ||
+		blobmsg_add_u8(&b, "config_hits", 1U) != 0 ||
+		blobmsg_add_string(&b, "event", "dns_block") != 0 ||
+		blobmsg_add_u8(&b, "source_ip", 1U) != 0) {
+		blob_buf_free(&b);
+		return UBUS_STATUS_UNKNOWN_ERROR;
+	}
+	result = ubus_send_reply(ctx, req, b.head);
+	blob_buf_free(&b);
+	return result;
+}
