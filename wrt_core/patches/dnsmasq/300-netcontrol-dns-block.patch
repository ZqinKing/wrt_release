+void ubus_dns_notify_block(const char *name, const union mysockaddr *source)
+{
+	struct ubus_context *ubus = (struct ubus_context *)daemon->ubus;
+	union mysockaddr source_address;
+	char source_ip[INET6_ADDRSTRLEN];
+	char device_mac[18];
+	unsigned char mac[6];
+	const void *address;
+	int mac_length;
+	int family;
+
+	if (!ubus || !ubus_dns_object.has_subscribers || !name || !source)
+		return;
+	source_address = *source;
+	mac_length = find_mac(&source_address, mac, 1, dnsmasq_time());
+	if (mac_length == 6)
+		(void)snprintf(device_mac, sizeof(device_mac), "%02x:%02x:%02x:%02x:%02x:%02x",
+			mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+	if (source->sa.sa_family == AF_INET) {
+		family = AF_INET;
+		address = &source->in.sin_addr;
+	} else if (source->sa.sa_family == AF_INET6) {
+		family = AF_INET6;
+		address = &source->in6.sin6_addr;
+	} else {
+		return;
+	}
+	if (inet_ntop(family, address, source_ip, sizeof(source_ip)) == NULL ||
+		blob_buf_init(&b, 0) != 0)
+		return;
+	if (blobmsg_add_string(&b, "name", name) != 0 ||
+		blobmsg_add_string(&b, "src_ip", source_ip) != 0 ||
+		blobmsg_add_string(&b, "action", "block") != 0) {
+		blob_buf_free(&b);
+		return;
+	}
+	if (mac_length == 6 && blobmsg_add_string(&b, "mac", device_mac) != 0) {
+		blob_buf_free(&b);
+		return;
+	}
+	(void)ubus_notify(ubus, &ubus_dns_object, "dns_block", b.head, -1);
+	blob_buf_free(&b);
+}
